#!/usr/bin/env sh
npx --no -- commitlint --edit "$1"
status=$?

if [ $status -ne 0 ]; then
  echo ""
  echo "Expected format: <type>: <short description>"
  echo "Examples:"
  echo "  feat: add login screen"
  echo "  fix: handle empty profile form"
  echo "  chore: add GitHub commit rules and validation"
  echo ""
  echo "Common types: feat, fix, docs, chore, refactor, test, ci"
fi

exit $status
